{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.0.32",
  "name": "@huntagent/core",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "db": "bun drizzle-kit",
    "migration": "bun run script/migration.ts",
    "fix-node-pty": "bun run script/fix-node-pty.ts",
    "benchmark:location": "bun run script/benchmark-location.ts",
    "benchmark:location-memory": "bun run script/benchmark-location-memory.ts",
    "build": "bun run script/build.ts",
    "update-models-snapshot": "bun run script/update-models-snapshot.ts",
    "test": "bun run script/test.ts",
    "typecheck": "tsgo -b tsconfig.json tsconfig.tests.json"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#sqlite": {
      "workerd": "./src/infrastructure/database/sqlite.workerd.ts",
      "bun": "./src/infrastructure/database/sqlite.bun.ts",
      "node": "./src/infrastructure/database/sqlite.node.ts",
      "default": "./src/infrastructure/database/sqlite.node.ts"
    },
    "#pty": {
      "workerd": "./src/infrastructure/pty/pty.workerd.ts",
      "bun": "./src/infrastructure/pty/pty.bun.ts",
      "node": "./src/infrastructure/pty/pty.node.ts",
      "default": "./src/infrastructure/pty/pty.bun.ts"
    },
    "#persistent-pty-binary": {
      "workerd": "./src/infrastructure/persistent-pty/binary.workerd.ts",
      "bun": "./src/infrastructure/persistent-pty/binary.bun.ts",
      "node": "./src/infrastructure/persistent-pty/binary.node.ts",
      "default": "./src/infrastructure/persistent-pty/binary.bun.ts"
    },
    "#fff": {
      "workerd": "./src/infrastructure/filesystem/fff.workerd.ts",
      "bun": "./src/infrastructure/filesystem/fff.bun.ts",
      "node": "./src/infrastructure/filesystem/fff.node.ts",
      "default": "./src/infrastructure/filesystem/fff.bun.ts"
    },
    "#photon-wasm": {
      "workerd": "./src/infrastructure/image/photon-wasm.workerd.ts",
      "bun": "./src/infrastructure/image/photon-wasm.bun.ts",
      "node": "./src/infrastructure/image/photon-wasm.node.ts",
      "default": "./src/infrastructure/image/photon-wasm.bun.ts"
    },
    "#shell-parser-wasm": {
      "workerd": "./src/infrastructure/shell/parser-wasm.workerd.ts",
      "bun": "./src/infrastructure/shell/parser-wasm.bun.ts",
      "node": "./src/infrastructure/shell/parser-wasm.node.ts",
      "default": "./src/infrastructure/shell/parser-wasm.bun.ts"
    },
    "#v1-migration": {
      "types": "./src/infrastructure/database/v1-migration.bun.ts",
      "bun": "./src/infrastructure/database/v1-migration.bun.ts",
      "node": "./src/infrastructure/database/v1-migration.noop.ts",
      "workerd": "./src/infrastructure/database/v1-migration.noop.ts",
      "default": "./src/infrastructure/database/v1-migration.noop.ts"
    }
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@modelcontextprotocol/server": "2.0.0",
    "@huntagent/http-recorder": "workspace:*",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/which": "3.0.4",
    "drizzle-kit": "catalog:",
    "fast-check": "catalog:"
  },
  "dependencies": {
    "@ai-sdk/cohere": "3.0.27",
    "@ai-sdk/perplexity": "3.0.26",
    "@ai-sdk/provider": "3.0.8",
    "@ai-sdk/provider-utils": "4.0.23",
    "@ai-sdk/vercel": "2.0.39",
    "@ff-labs/fff-bun": "0.10.5",
    "@ff-labs/fff-node": "0.10.5",
    "@lydell/node-pty": "catalog:",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@opencode-ai/pty": "0.2.0",
    "@huntagent/ai": "workspace:*",
    "@huntagent/codemode": "workspace:*",
    "@huntagent/plugin": "workspace:*",
    "@huntagent/schema": "workspace:*",
    "@huntagent/util": "workspace:*",
    "@parcel/watcher": "2.5.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@standard-schema/spec": "catalog:",
    "bun-pty": "0.4.11",
    "diff": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "fuzzysort": "3.1.0",
    "gitlab-ai-provider": "6.19.0",
    "gray-matter": "4.0.3",
    "htmlparser2": "8.0.2",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "immer": "11.1.4",
    "jose": "6.0.11",
    "jsonc-parser": "3.3.1",
    "mime-types": "3.0.2",
    "tree-sitter-bash": "0.25.0",
    "tree-sitter-powershell": "0.25.10",
    "web-tree-sitter": "0.25.10",
    "which": "6.0.1",
    "zod": "catalog:"
  }
}
